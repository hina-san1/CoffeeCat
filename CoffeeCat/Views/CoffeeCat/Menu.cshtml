@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="drawer lg:drawer-open">
    <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content h-screen overflow-hidden flex flex-col">
        <nav class="navbar w-full bg-base-300 flex justify-between items-center px-4">
            <div class="flex items-center">
                <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                        <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
                        <path d="M9 4v16"></path>
                        <path d="M14 10l2 2l-2 2"></path>
                    </svg>
                </label>
                <div class="px-4 text-xl font-bold">Coffee Cat</div>
            </div>

            <div ng-if="isLoggedIn" class="flex items-center gap-4">
                    <span class="font-bold text-coffee-dark hidden sm:inline">Hi, {{ currentUser }}!</span>
                    <button class="text-sm hover:underline transition cursor-pointer text-red-600" ng-click="logout()">Logout</button>
            </div>
        </nav>

        <div class="flex-1 grid grid-cols-5 overflow-hidden text-gray-700"> 
            <div class="p-8 col-span-5 lg:col-span-4 flex flex-col gap-6 overflow-hidden">
                <div class="flex gap-10 overflow-x-auto no-scrollbar">
                    <button ng-click="setCategory('all')"
                            ng-class="{'bg-coffee-light text-white': selectedCategory === 'all', 'text-gray-700': selectedCategory !== 'all'}"
                            class="px-5 py-2 rounded-full transition-colors cursor-pointer whitespace-nowrap">
                        All
                    </button>
                    <button ng-click="setCategory('iced')"
                            ng-class="{'bg-coffee-light text-white': selectedCategory === 'iced', 'text-gray-700': selectedCategory !== 'iced'}"
                            class="px-5 py-2 rounded-full transition-colors cursor-pointer whitespace-nowrap">
                        Iced
                    </button>
                    <button ng-click="setCategory('hot')"
                            ng-class="{'bg-coffee-light text-white': selectedCategory === 'hot', 'text-gray-700': selectedCategory !== 'hot'}"
                            class="px-5 py-2 rounded-full transition-colors cursor-pointer whitespace-nowrap">
                        Hot
                    </button>
                    <button ng-click="setCategory('matcha')"
                            ng-class="{'bg-coffee-light text-white': selectedCategory === 'matcha', 'text-gray-700': selectedCategory !== 'matcha'}"
                            class="px-5 py-2 rounded-full transition-colors cursor-pointer whitespace-nowrap">
                        Matcha
                    </button>
                </div>

                <div>
                    <h2 class="text-lg font-semibold">Coffee Menu</h2>
                </div>

                <div class="flex-1 overflow-y-auto pb-8 pr-8">
                    <div class="grid md:grid-cols-2 gap-6 motion-translate-y-in-100">
                        <div ng-repeat="item in menuItems | filter:categoryFilter"
                             class="w-full border border-gray-200 shadow-lg p-6 rounded-3xl flex flex-col xl:flex-row gap-4 min-h-fit bg-white">
                            <div class="p-8 bg-gray-200 rounded-2xl flex justify-center items-center shrink-0 h-52 xl:w-52 xl:h-auto">
                                <img ng-src="{{item.image}}" alt="{{item.name}}"
                                     class="max-h-full max-w-full object-contain" />
                            </div>

                            <div class="flex-1 flex flex-col justify-between space-y-3 min-w-0">
                                <div class="flex justify-between text-xl text-coffee-light font-semibold">
                                    <h2 class="truncate pr-2">{{item.name}}</h2>
                                    <h2 class="whitespace-nowrap">₱{{item.price | number:2}}</h2>
                                </div>
                                <div>
                                    <p class="line-clamp-5 text-sm">{{item.description}}</p>
                                </div>
                                <button class="btn-coffee w-full mt-4" ng-click="addToCart(item)">
                                    Add to cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lg:hidden fixed bottom-6 left-0 right-0 px-4 z-50" ng-if="cart.length > 0">
                    <button ng-click="openCart()"
                            class="w-full bg-coffee-light text-white p-4 rounded-2xl shadow-2xl flex justify-between items-center font-bold animate-in slide-in-from-bottom duration-300">
                        <div class="flex items-center gap-3">
                            <span class="bg-white text-coffee-light rounded-lg px-2 py-0.5 text-sm">{{cart.length}}</span>
                            <span>View your cart</span>
                        </div>
                        <span>₱{{getTotal() | number:2}}</span>
                    </button>
                </div>

                <dialog modal-show="isCartOpen" class="modal modal-bottom sm:modal-middle">
                </dialog>
            </div>

            <div class="hidden lg:flex p-4 flex-col h-full overflow-hidden border-l border-gray-100 bg-white col-span-1">
                <h2 class="text-lg font-semibold mb-4">Cart</h2>
                <div ng-include="'CartTemplate.html'" class="flex-1 flex flex-col overflow-hidden"></div>
            </div>
        </div>
    </div>

    <div class="drawer-side is-drawer-close:overflow-visible">
        <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-14 is-drawer-open:w-64">
            <ul class="menu w-full grow bg-coffee-light">
                <li class="text-white mb-2 pointer-events-none">
                    <div class="flex items-center gap-2">
                        <img src="~/Content/assets/logo-coffee-cat.png" alt="logo" class="h-5 w-auto" />
                        <span class="is-drawer-close:hidden font-bold">Coffee Cat</span>
                    </div>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('Home')">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             stroke-linejoin="round"
                             stroke-linecap="round"
                             stroke-width="2"
                             fill="none"
                             stroke="currentColor"
                             class="my-1.5 inline-block size-4">
                            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
                            <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        </svg>
                        <span class="is-drawer-close:hidden">Home</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('Menu')">
                        <svg class="w-6 h-6 text-gray-800 dark:text-white"
                             aria-hidden="true"
                             xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             fill="none"
                             viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10" />
                        </svg>
                        <span class="is-drawer-close:hidden">Menu</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('UserOrder')">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="my-1.5 inline-block size-4">
                            <path d="M15 4h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3m0 3h6m-6 5h6m-6 4h6M10 3v4h4V3h-4Z" />
                        </svg>
                        <span class="is-drawer-close:hidden">Orders</span>
                    </button>
                </li>
                <li class="text-white">
                    <button ng-click="logout()">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="my-1.5 inline-block size-4">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span class="is-drawer-close:hidden">Logout</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>

<dialog modal-show="isCartOpen" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box p-0 bg-white h-[85vh] flex flex-col max-w-none sm:max-w-lg">
        <div class="p-6 border-b flex justify-between items-center">
            <h3 class="font-bold text-xl">My Cart</h3>
            <button 
                class="btn btn-sm btn-circle btn-ghost"
                ng-click="closeCart()">
                ✕
            </button>
        </div>
        <div class="flex-1 overflow-hidden p-6 flex flex-col">
            <div ng-include="'CartTemplate.html'" class="h-full flex flex-col overflow-hidden"></div>
        </div>
    </div>
</dialog>

<script type="text/ng-template" id="CartTemplate.html">
    <div class="flex-1 flex flex-col overflow-hidden">
        <div ng-if="cart.length === 0" class="flex-1 flex flex-col items-center justify-center text-gray-400 text-center p-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-12 mb-2 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
            <p>Your cart is empty</p>
        </div>

        <div ng-if="cart.length > 0" class="flex-1 overflow-y-auto flex flex-col gap-3 pr-2">
            <div ng-repeat="item in cart" class="flex items-center gap-3 p-3 bg-white rounded-2xl shadow-sm border border-gray-100">
                <div class="size-16 bg-gray-100 rounded-xl shrink-0">
                    <img ng-src="{{item.image}}" class="size-full object-contain p-1" />
                </div>
                <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-bold truncate text-gray-800">{{item.name}}</h4>
                    <p class="text-xs text-coffee-light font-bold">₱{{(item.price * item.quantity) | number:2}}</p>
                    <div class="flex items-center justify-between mt-2">
                        <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-2 py-1">
                            <button ng-click="updateQuantity(item, -1)" class="hover:text-coffee-light font-bold">-</button>
                            <span class="text-xs font-bold w-4 text-center">{{item.quantity}}</span>
                            <button ng-click="updateQuantity(item, 1)" class="hover:text-coffee-light font-bold">+</button>
                        </div>
                        <button ng-click="removeFromCart(item)" class="text-xs text-red-400 hover:text-red-600">Remove</button>
                    </div>
                </div>
            </div>
        </div>

        <div ng-if="cart.length > 0" class="mt-4 pt-4 border-t border-dashed border-gray-300 space-y-2">
            <div class="flex justify-between text-sm text-gray-500">
                <span>Tax (12%)</span>
                <span class="text-black font-medium">₱{{getTax() | number:2}}</span>
            </div>
            <div class="flex justify-between mt-2 items-baseline">
                <h3 class="font-bold">Total</h3>
                <h3 class="text-coffee-light text-xl font-bold">₱{{getTotal() | number:2}}</h3>
            </div>
            <div class="mt-4">
                <button ng-click="checkout()" class="btn-coffee w-full py-3 rounded-2xl">Checkout</button>
            </div>
        </div>
    </div>
</script>