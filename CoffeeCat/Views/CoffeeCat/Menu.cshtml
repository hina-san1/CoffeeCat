@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="drawer lg:drawer-open ">
    <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content h-screen overflow-hidden flex flex-col">
        <!-- Navbar -->
        <nav class="navbar w-full bg-base-300">
            <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4"><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path><path d="M9 4v16"></path><path d="M14 10l2 2l-2 2"></path></svg>
            </label>
            <div class="px-4 text-xl font-bold">Coffee Cat</div>
        </nav>

        <!-- Page content here -->
        <div class="flex-1 grid grid-cols-5 overflow-hidden text-gray-700">
            <div class="p-8 col-span-5 lg:col-span-4 flex flex-col gap-6 overflow-hidden">

                <!-- Menu Category Buttons -->
                <div class="flex gap-10">
                    <button ng-click="setCategory('all')"
                            ng-class="{'bg-coffee-light text-white': selectedCategory === 'all', 'text-gray-700': selectedCategory !== 'all'}"
                            class="px-6 py-2 rounded-full transition-colors cursor-pointer">
                        All
                    </button>
                    <button ng-click="setCategory('iced')"
                            ng-class="{'bg-coffee-light text-white': selectedCategory === 'iced', 'text-gray-700': selectedCategory !== 'iced'}"
                            class="px-6 py-2 rounded-full transition-colors cursor-pointer">
                        Iced
                    </button>
                    <button ng-click="setCategory('hot')"
                            ng-class="{'bg-coffee-light text-white': selectedCategory === 'hot', 'text-gray-700': selectedCategory !== 'hot'}"
                            class="px-6 py-2 rounded-full transition-colors cursor-pointer">
                        Hot
                    </button>
                    <button ng-click="setCategory('matcha')"
                            ng-class="{'bg-coffee-light text-white': selectedCategory === 'matcha', 'text-gray-700': selectedCategory !== 'matcha'}"
                            class="px-6 py-2 rounded-full transition-colors cursor-pointer">
                        Matcha
                    </button>
                </div>

                <div>
                    <h2 class="text-lg font-semibold">Coffee Menu</h2>
                </div>

                <div class="flex-1 overflow-y-auto pb-8 pr-8">
                    <div class="grid md:grid-cols-2 gap-6
                         motion-translate-y-in-100">
                        <!-- Menu -->
                        <div ng-repeat="item in menuItems | filter:categoryFilter"
                             class="w-full border border-gray-200 shadow-lg p-6 rounded-3xl flex flex-col xl:flex-row gap-4 min-h-fit">
                            <div class="p-8 bg-gray-200 rounded-2xl flex justify-center items-center shrink-0 h-52 xl:w-52 xl:h-auto">
                                <img ng-src="{{item.image}}" alt="{{item.name}}"
                                     class="max-h-full max-w-full object-contain" />
                            </div>

                            <div class="flex-1 flex flex-col justify-between space-y-3 min-w-0">
                                <div class="flex justify-between text-xl text-coffee-light font-semibold">
                                    <h2>{{item.name}}</h2>
                                    <h2 class="whitespace-nowrap">₱{{item.price}}</h2>
                                </div>

                                <div>
                                    <p class="line-clamp-5 text-sm">{{item.description}}</p>
                                </div>

                                <button class="btn-coffee w-full mt-4">
                                    Add to cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 flex flex-col h-full overflow-hidden">
                <!-- Cart -->
                <div>
                    <h2 class="text-lg font-semibold">Cart</h2>
                </div>

                <div class="overflow-y-auto h-full flex flex-col gap-3">
                    <img src="~/Content/assets/matcha latte.png" />
                </div>

                <div class="space-y-2 text-gray-400 text-sm">
                    <div class="flex justify-between">
                        <h3>Tax</h3>
                        <h3 class="text-black">₱32.00</h3>
                    </div>

                    <div class="flex justify-between">
                        <h3>Subtotal</h3>
                        <h3 class="text-black">₱187.00</h3>
                    </div>

                    <div class="flex justify-between mt-6">
                        <h3>Total</h3>
                        <h3 class="text-coffee-light">₱210.00</h3>
                    </div>

                    <div class="mt-6">
                        <button class="btn-coffee w-full">
                            Add to cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="drawer-side is-drawer-close:overflow-visible">
        <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-14 is-drawer-open:w-64">
            <ul class="menu w-full grow">
                <li>
                    <button class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Homepage" ng-click="redirect('Home')">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                        <span class="is-drawer-close:hidden">Home</span>
                    </button>
                </li>
                <li>
                    <button class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Settings">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg>
                        <span class="is-drawer-close:hidden">Settings</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>

<!--Ssave-->