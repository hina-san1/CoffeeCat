@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="drawer lg:drawer-open">
    <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content h-screen overflow-hidden flex flex-col">
        <nav class="navbar w-full bg-base-300 flex justify-between items-center px-4">
            <div class="flex items-center">
                <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                        <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
                        <path d="M9 4v16"></path>
                        <path d="M14 10l2 2l-2 2"></path>
                    </svg>
                </label>
                <div class="px-4 text-xl font-bold">Dashboard</div>
            </div>

            <div ng-if="isLoggedIn" class="flex items-center gap-4">
                <span class="font-bold text-coffee-dark hidden sm:inline">Hi, {{ currentUser }}!</span>
                <button class="text-sm hover:underline transition cursor-pointer text-red-600" ng-click="logout()">Logout</button>
            </div>
        </nav>

        <div class="p-8 flex-1 overflow-y-auto bg-gray-50">
            <div class="space-y-6">
                <!-- Card Stats -->
                <div class="grid lg:grid-cols-4 md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 shadow-md rounded-xl border-gray-100 space-y-2">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-500 font-medium">Total Users</p>
                            <div class="p-2 bg-coffee-light/20 text-coffee-light rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-gray-800">{{ dashboardStats.totalUsers }}</h3>
                        </div>
                    </div>

                    <div class="bg-white p-6 shadow-md rounded-xl border-gray-100 space-y-2">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-500 font-medium">Total Orders</p>
                            <div class="p-2 bg-coffee-light/20 text-coffee-light rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-gray-800">{{ dashboardStats.totalOrders }}</h3>
                        </div>
                    </div>

                    <div class="bg-white p-6 shadow-md rounded-xl border-gray-100 space-y-2">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-500 font-medium">Pending Orders</p>
                            <div class="p-2 bg-coffee-light/20 text-coffee-light rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-gray-800">{{ dashboardStats.pendingOrders }}</h3>
                        </div>
                    </div>

                    <div class="bg-white p-6 shadow-md rounded-xl border-gray-100 space-y-2">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-500 font-medium">Completed Orders</p>
                            <div class="p-2 bg-coffee-light/20 text-coffee-light rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-gray-800">{{ dashboardStats.completedOrders }}</h3>
                        </div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="space-y-4">
                    <!-- Bar Chart -->
                    <div class="bg-white p-6 shadow-md rounded-2xl border border-gray-100 w-full">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-lg font-bold text-gray-800">Monthly Revenue</h3>
                            <p class="text-xs text-gray-400 font-medium">Data based on completed orders for {{ year }}</p>
                        </div>

                        <div class="relative w-full h-64 md:h-80">
                            <canvas id="bar" class="chart chart-bar"
                                    chart-data="barData" chart-labels="barLabels" chart-series="barSeries"
                                    chart-options="barOptions" chart-colors="barColors">
                            </canvas>
                        </div>
                    </div>

                    <div class="grid lg:grid-cols-2 gap-6">
                        <!-- Pie Chart -->
                        <div class="bg-white p-6 shadow-md rounded-2xl border border-gray-100">
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-lg font-bold text-gray-800">Popular Drinks</h3>
                                <p class="text-xs text-gray-400 font-medium">Top 5 selling items</p>
                            </div>

                            <div class="relative w-full h-64 md:h-80">
                                <canvas id="pie" class="chart chart-pie"
                                        chart-data="pieData" chart-labels="pieLabels" chart-colors="pieColors" chart-options="pieOptions">
                                </canvas>
                            </div>
                        </div>

                        <!-- Doughnut Chart -->
                        <div class="bg-white p-6 shadow-md rounded-2xl border border-gray-100">
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-lg font-bold text-gray-800">Order Status Distribution</h3>
                                <p class="text-xs text-gray-400 font-medium">Operational status overview</p>
                            </div>

                            <div class="relative w-full h-64 md:h-80">
                                <canvas id="doughnut" class="chart chart-doughnut"
                                        chart-data="doughnutData" chart-labels="doughnutLabels" chart-colors="doughnutColors" chart-options="doughnutOptions">
                                </canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Users Table -->
                <div class="overflow-x-auto bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-gray-800">Recent Users</h3>
                            <p class="text-sm text-gray-500">The 10 recently registered customers</p>
                        </div>
                        <button class="btn btn-sm btn-outline border-coffee-light text-coffee-dark hover:bg-coffee-light hover:border-coffee-light"
                                ng-click="redirect('AdminUsers')">
                            View All
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="table w-full">
                            <thead>
                                <tr class="text-coffee-dark border-b border-gray-100">
                                    <th>#</th>
                                    <th>Username</th>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Contact</th>
                                    <th>Joined Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="user in allCustomers | limitTo: 10" class="hover:bg-gray-50 transition-colors border-b border-gray-50 last:border-0">
                                    <th class="text-gray-400 font-normal">{{ $index + 1 }}</th>
                                    <td class="text-coffee-dark font-bold">{{ user.username }}</td>
                                    <td class="font-medium text-gray-700">{{ user.first_name }} {{ user.last_name }}</td>
                                    <td class="text-blue-600">{{ user.email }}</td>
                                    <td>{{ user.contact || 'N/A' }}</td>
                                    <td class="text-gray-500 text-sm">{{ user.created_at }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div ng-if="allCustomers.length === 0" class="py-10 text-center opacity-60">
                        <p>No registered users found.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="drawer-side is-drawer-close:overflow-visible">
        <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="flex min-h-full flex-col items-start bg-coffee-light is-drawer-close:w-14 is-drawer-open:w-64">
            <ul class="menu w-full grow bg-coffee-light">

                <li class="text-white mb-2 pointer-events-none">
                    <div class="flex items-center gap-2">
                        <img src="~/Content/assets/logo-coffee-cat.png" alt="logo" class="h-5 w-auto" />
                        <span class="is-drawer-close:hidden font-bold">Coffee Cat</span>
                    </div>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('AdminDashboard')">
                        <svg xmlns="http://www.w3.org/2000/svg" 
                             viewBox="0 0 24 24" 
                             fill="none" 
                             stroke="currentColor" 
                             stroke-width="2" 
                             stroke-linecap="round" 
                             stroke-linejoin="round" 
                             class="size-4">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        <span class="is-drawer-close:hidden">Dashboard</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('AdminOrders')">
                        <svg xmlns="http://www.w3.org/2000/svg" 
                             viewBox="0 0 24 24" 
                             fill="none" 
                             stroke="currentColor"
                             stroke-width="2" 
                             stroke-linecap="round"
                             stroke-linejoin="round" 
                             class="size-4">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                        <span class="is-drawer-close:hidden">Orders</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('AdminUsers')">
                        <svg xmlns="http://www.w3.org/2000/svg" 
                             viewBox="0 0 24 24" 
                             fill="none" 
                             stroke="currentColor" 
                             stroke-width="2" 
                             stroke-linecap="round" 
                             stroke-linejoin="round" 
                             class="size-4">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <span class="is-drawer-close:hidden">Users</span>
                    </button>
                </li>
            </ul>

            <ul class="menu w-full mt-auto">
                <li class="text-white">
                    <button ng-click="logout()">
                        <svg xmlns="http://www.w3.org/2000/svg" 
                             viewBox="0 0 24 24" 
                             fill="none" 
                             stroke="currentColor" 
                             stroke-width="2" 
                             stroke-linecap="round" 
                             stroke-linejoin="round" 
                             class="size-4">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span class="is-drawer-close:hidden">Logout</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>

