@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="drawer lg:drawer-open" ng-init="checkSession()">
    <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content h-screen overflow-hidden flex flex-col">
        <nav class="navbar w-full bg-base-300 flex justify-between items-center px-4">
            <div class="flex items-center">
                <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                        <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
                        <path d="M9 4v16"></path>
                        <path d="M14 10l2 2l-2 2"></path>
                    </svg>
                </label>
                <div class="px-4 text-xl font-bold">Coffee Cat</div>
            </div>

            <div class="flex items-center gap-4">
                <div ng-if="isLoggedIn" class="flex items-center gap-4">
                    <span class="font-bold text-coffee-dark hidden sm:inline">Hi, {{ currentUser }}!</span>
                    <button class="text-sm hover:underline transition cursor-pointer text-red-600" ng-click="logout()">Logout</button>
                </div>
            </div>
        </nav>

        <div class="p-8 flex-1 overflow-y-auto bg-gray-50">
            <div class="space-y-4 h-full flex flex-col">
                <div>
                    <h1 class="text-3xl font-semibold">My Orders</h1>
                    <p class="text-gray-500">Below are the current list of your orders.</p>
                </div>

                <div ng-if="userOrders.length > 0" class="overflow-x-auto bg-white w-full rounded-2xl shadow-sm border border-gray-100">
                    <table class="table w-full">
                        <thead>
                            <tr class="text-coffee-dark">
                                <th>#</th>
                                <th>Order ID</th>
                                <th>Item</th>
                                <th>Qty</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="order in userOrders" class="hover:bg-gray-50 transition-colors">
                                <th>{{ $index + 1 }}</th>
                                <td class="font-mono text-xs font-bold">{{ order.order_id_string }}</td>
                                <td>{{ order.item_name }}</td>
                                <td>{{ order.quantity }}</td>
                                <td class="font-bold">₱{{ order.total_price }}</td>
                                <td>
                                    <span class="badge font-semibold"
                                          ng-class="{'badge-info': order.status === 'Preparing', 'badge-success': order.status === 'Completed', 'badge-warning': order.status === 'Pending'}">
                                        {{ order.status }}
                                    </span>
                                </td>
                                <td>{{ order.created_at }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div ng-if="userOrders.length === 0" class="flex-1 flex flex-col items-center justify-center text-center space-y-4 opacity-60">
                    <div class="p-6 bg-gray-200 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 4.394 8.25h15.212a1.125 1.125 0 0 1 1.1 1.257Z" />
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800">No recent orders</h2>
                    <button class="btn-coffee px-10" ng-click="redirect('Menu')">Go to Menu</button>
                </div>
            </div>
        </div>
    </div>

    <div class="drawer-side is-drawer-close:overflow-visible">
        <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-14 is-drawer-open:w-64">
            <ul class="menu w-full grow bg-coffee-light">
                <li class="text-white">
                    <button ng-click="redirect('Home')">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             stroke-linejoin="round"
                             stroke-linecap="round"
                             stroke-width="2"
                             fill="none"
                             stroke="currentColor"
                             class="my-1.5 inline-block size-4">
                            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
                            <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        </svg>
                        <span class="is-drawer-close:hidden">Home</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('Menu')">
                        <svg class="w-6 h-6 text-gray-800 dark:text-white"
                             aria-hidden="true"
                             xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             fill="none"
                             viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10" />
                        </svg>
                        <span class="is-drawer-close:hidden">Menu</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('UserOrder')">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="my-1.5 inline-block size-4">
                            <path d="M15 4h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3m0 3h6m-6 5h6m-6 4h6M10 3v4h4V3h-4Z" />
                        </svg>
                        <span class="is-drawer-close:hidden">Orders</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>