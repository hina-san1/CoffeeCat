@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="drawer lg:drawer-open">
    <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content h-screen overflow-hidden flex flex-col">
        <nav class="navbar w-full bg-base-300">
            <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4"><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path><path d="M9 4v16"></path><path d="M14 10l2 2l-2 2"></path></svg>
            </label>
            <div class="px-4 text-xl font-bold">Coffee Cat</div>
        </nav>

        <div class="p-8">
            <div class="space-y-4">
                <h1 class="text-3xl font-semibold">My Orders</h1>
                <p class="text-gray-500">Below are the current list of your orders.</p>

                <div class="overflow-x-auto bg-white w-full">
                    <table class="table w-full">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Order ID</th>
                                <th>Item</th>
                                <th>Qty</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>1</th>
                                <td>ORD-2001</td>
                                <td>Caramel Latte</td>
                                <td>1</td>
                                <td>₱4.00</td>
                                <td><span class="badge badge-info">Preparing</span></td>
                                <td>2026-03-29</td>
                            </tr>
                            <tr>
                                <th>2</th>
                                <td>ORD-2002</td>
                                <td>Mocha</td>
                                <td>2</td>
                                <td>₱8.00</td>
                                <td><span class="badge badge-success">Completed</span></td>
                                <td>2026-03-27</td>
                            </tr>
                            <tr>
                                <th>3</th>
                                <td>ORD-2003</td>
                                <td>Americano</td>
                                <td>1</td>
                                <td>₱3.00</td>
                                <td><span class="badge badge-warning">Pending</span></td>
                                <td>2026-03-25</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

   <div class="drawer-side is-drawer-close:overflow-visible">
        <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-14 is-drawer-open:w-64">
            <ul class="menu w-full grow bg-coffee-light">
                <li class="text-white">
                    <button ng-click="redirect('Home')">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             stroke-linejoin="round"
                             stroke-linecap="round"
                             stroke-width="2"
                             fill="none"
                             stroke="currentColor"
                             class="my-1.5 inline-block size-4">
                            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
                            <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        </svg>
                        <span class="is-drawer-close:hidden">Home</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('Menu')">
                        <svg class="w-6 h-6 text-gray-800 dark:text-white" 
                             aria-hidden="true" 
                             xmlns="http://www.w3.org/2000/svg" 
                             width="24" 
                             height="24" 
                             fill="none" 
                             viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10" />
                        </svg>
                        <span class="is-drawer-close:hidden">Menu</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('UserOrder')">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="my-1.5 inline-block size-4">
                            <path d="M15 4h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3m0 3h6m-6 5h6m-6 4h6M10 3v4h4V3h-4Z" />
                        </svg>
                        <span class="is-drawer-close:hidden">Orders</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>
