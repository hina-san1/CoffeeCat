@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="min-h-screen flex flex-col items-center p-8 space-y-8">
    <h1 class="text-center text-3xl font-bold">Admin Dashboard</h1>
    <div class="min-w-3xl space-y-5 bg-white shadow-lg rounded-3xl p-8 border border-gray-200">
        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
            <input type="email" placeholder="example@gmail.com"
                   class="w-full px-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-coffee-light focus:outline-none font-light" required />
        </div>

        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Password</label>
            <input type="text" placeholder="password"
                   class="w-full px-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-coffee-light focus:outline-none font-light" required />
        </div>

        <button type="submit"
                class="btn-coffee py-4 transition-all duration-300">
            Update
        </button>
    </div>

    <div class="min-w-3xl space-y-5 bg-white shadow-lg rounded-3xl p-8 border border-gray-200">
        <table class="w-full">
            <thead class="hidden md:table-header-group">
                <tr class="text-left border-b border-gray-300">
                    <th class="p-2">Email</th>
                    <th class="p-2">Password</th>
                    <th class="p-2">Actions</th>
                </tr>
            </thead>

            <tbody class="block md:table-row-group">
                <tr ng-repeat="userData in userArray track by $index"
                    class="border-b border-gray-500/50 md:border-gray-300 block md:table-row mb-6 md:mb-0 pb-4 md:pb-0">

                    <td data-label="Full Name" class="p-2 break-words flex justify-between md:table-cell items-center">
                        <span class="font-bold md:hidden">Full Name:</span>
                        <span class="text-right md:text-left">{{userData.Email}}</span>
                    </td>

                    <td data-label="Username" class="p-2 break-words flex justify-between md:table-cell items-center">
                        <span class="font-bold md:hidden">Username:</span>
                        <span class="text-right md:text-left">{{userData.Password}}</span>
                    </td>

                    <td class="p-2 flex flex-col md:table-cell">
                        <span class="font-bold md:hidden mb-2">Actions:</span>
                        <div class="flex flex-row md:flex-col lg:flex-row gap-2">
                            <button class="my-btn w-full py-1 text-sm" ng-click="update($index)"> UPDATE </button>
                            <button class="my-btn w-full bg-red-500/20 py-1 text-sm" ng-click="delete($index)"> DELETE </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

