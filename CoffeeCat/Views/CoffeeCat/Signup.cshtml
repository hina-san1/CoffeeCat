@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="bg-white min-h-screen flex items-center justify-center">
    <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0 w-full">

        <a href="#" class="flex items-center mb-8 text-2xl font-bold text-coffee-light">
            <img class="w-10 h-10 mr-3 object-contain" src="~/Content/assets/logo-coffee-cat.png" alt="logo">
            <span>Coffee Cat</span>
        </a>

        <div class="w-full bg-white shadow-lg rounded-3xl p-8 border border-gray-200 sm:max-w-md
             motion-translate-y-in-100">
            <div class="space-y-6">
                <h1 class="text-3xl font-bold text-coffee-light text-center">
                    Create an account
                </h1>

                <form name="signupForm" class="space-y-5" ng-submit="signup()">
                    <div>
                        <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Your email</label>
                        <input type="email" name="email" id="email"
                               class="w-full px-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-coffee-light focus:outline-none font-light"
                               placeholder="example@gmail.com" required 
                               ng-model="email">
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">Password</label>
                        <input type="password" name="password" id="password"
                               placeholder="••••••••"
                               class="w-full px-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-coffee-light focus:outline-none font-light" required
                               ng-model="password">
                    </div>

                    <div>
                        <label for="confirm-password" class="block text-sm font-semibold text-gray-700 mb-2">Confirm password</label>
                        <input type="password" name="confirm-password" id="confirm-password"
                               placeholder="••••••••"
                               class="w-full px-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-coffee-light focus:outline-none font-light" required
                               ng-model="confirmPassword">
                    </div>

                    <button type="submit"   
                            class="w-full btn-coffee py-4 transition-all duration-300">
                        Create an account
                    </button>

                    <p class="text-sm font-light text-gray-500 text-center">
                        Already have an account?
                        <a class="font-semibold text-coffee-light hover:underline" ng-click="redirect('Login')">Login here</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>