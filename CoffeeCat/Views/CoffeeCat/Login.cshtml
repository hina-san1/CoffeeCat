@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="bg-white min-h-screen flex items-center justify-center">
    <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0 w-full">

        <a href="#" class="flex items-center mb-8 text-2xl font-bold text-coffee-light">
            <img class="w-10 h-10 mr-3 object-contain" src="~/Content/assets/logo-coffee-cat.png" alt="logo">
            <span>Coffee Cat</span>
        </a>

        <div class="w-full bg-white shadow-lg rounded-3xl p-8 border border-gray-200 sm:max-w-md
             motion-translate-y-in-100">
            <div class="space-y-6">
                <h1 class="text-3xl font-bold text-coffee-light text-center">
                    Welcome Back
                </h1>

                <form name="loginForm" class="space-y-5">
                    <div>
                        <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
                        <input type="email" 
                               name="email" 
                               id="email"
                               class="w-full px-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-coffee-light focus:outline-none font-light"
                               placeholder="example@gmail.com" 
                               ng-model="login_email">
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label for="password" class="block text-sm font-semibold text-gray-700">Password</label>
                        </div>
                        <input type="password" 
                               name="password" 
                               id="password"
                               maxlength="16"
                               placeholder="Enter your Password"
                               class="w-full px-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-coffee-light focus:outline-none font-light"
                               ng-model="login_password">
                    </div>

                    <button type="submit" 
                            ng-click="loginUserData()"
                            class="w-full btn-coffee py-4 transition-all duration-300">
                        Login
                    </button>

                    <p class="text-sm font-light text-gray-500 text-center">
                        Don't have an account?
                        <a href="#" class="font-semibold text-coffee-light hover:underline" ng-click="redirect('Signup')">Register here</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

<footer class="footer sm:footer-horizontal footer-center bg-coffee-light text-white p-4">
    <aside>
        <p>Copyright © <span>{{ year }}</span> - All right reserved by Coffee Cat</p>
    </aside>
</footer>
