@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex flex-col">

    <div class="drawer lg:drawer-open flex-1">
        <input id="my-drawer-3" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col">
            <nav class="py-3 px-4 flex items-center justify-between lg:hidden">
                <div class="flex items-center gap-2">
                    <label for="my-drawer-3" class="btn btn-ghost lg:hidden">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </label>
                    <img src="~/Content/assets/logo-coffee-cat.png" alt="logo" class="h-10 w-auto" />
                    <h2 class="text-xl font-bold">Coffee Cat</h2>
                </div>
            </nav>

            <main class="flex-1 flex flex-col items-center p-6 space-y-8">
                <h1 class="text-3xl font-bold">Users</h1>
                <!-- Table -->
                <div class="overflow-x-auto bg-white w-full">
                    <table class="table">
                        <!-- head -->
                        <thead>
                            <tr>
                                <th></th>
                                <th>Name</th>
                                <th>Job</th>
                                <th>Favorite Color</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- row 1 -->
                            <tr>
                                <th>1</th>
                                <td>Cy Ganderton</td>
                                <td>Quality Control Specialist</td>
                                <td>Blue</td>
                            </tr>
                            <!-- row 2 -->
                            <tr>
                                <th>2</th>
                                <td>Hart Hagerty</td>
                                <td>Desktop Support Technician</td>
                                <td>Purple</td>
                            </tr>
                            <!-- row 3 -->
                            <tr>
                                <th>3</th>
                                <td>Brice Swyre</td>
                                <td>Tax Accountant</td>
                                <td>Red</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </main>
        </div>

        <div class="drawer-side">
            <label for="my-drawer-3" aria-label="close sidebar" class="drawer-overlay"></label>

            <ul class="menu bg-coffee-light text-white min-h-full p-4">
                <li ng-click="redirect('AdminDashboard')"><a>Dashboard</a></li>
                <li ng-click="redirect('AdminsTable')"><a>Admins</a></li>
                <li ng-click="redirect('UsersTable')"><a>Users</a></li>
            </ul>
        </div>
    </div>
</div>