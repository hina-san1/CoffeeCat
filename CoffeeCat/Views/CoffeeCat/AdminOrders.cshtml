@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="drawer lg:drawer-open" ng-init="loadAdminOrders()">
    <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content h-screen overflow-hidden flex flex-col">
        <nav class="navbar w-full bg-base-300 flex justify-between items-center px-4">
            <div class="flex items-center">
                <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                        <path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
                        <path d="M9 4v16"></path>
                        <path d="M14 10l2 2l-2 2"></path>
                    </svg>
                </label>
                <div class="px-4 text-xl font-bold">Order Management</div>
            </div>

            <div ng-if="isLoggedIn" class="flex items-center gap-4">
                <span class="font-bold text-coffee-dark hidden sm:inline">Hi, {{ currentUser }}!</span>
                <button class="text-sm hover:underline transition cursor-pointer text-red-600" ng-click="logout()">Logout</button>
            </div>
        </nav>

        <div class="p-8 flex-1 overflow-y-auto bg-gray-50">
            <div class="max-w-6xl mx-auto">
                <div class="flex justify-between items-end mb-6">
                    <div>
                        <h2 class="text-2xl font-bold text-coffee-light">Customer Transactions</h2>
                        <p class="text-sm text-gray-500">Approve, process, and track all incoming coffee orders.</p>
                    </div>
                    <button class="btn btn-sm bg-coffee-light border-none text-white hover:bg-coffee-dark" ng-click="loadAdminOrders()">
                        Refresh List
                    </button>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <table class="table w-full">
                        <thead class="bg-gray-50 border-b border-gray-100">
                            <tr class="text-coffee-dark uppercase text-xs">
                                <th class="py-4">Order ID</th>
                                <th>Customer</th>
                                <th>Order Details</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                            <tr ng-repeat="order in allOrders" class="hover:bg-gray-50/50 transition-colors border-b border-gray-50 last:border-none">
                                <td class="font-bold text-coffee-light">#{{order.order_id}}</td>
                                <td>
                                    <div class="font-medium text-gray-700">{{order.customer_name}}</div>
                                    <div class="text-xs text-gray-400">{{order.date}}</div>
                                </td>
                                <td class="max-w-xs italic text-gray-600 truncate">
                                    {{order.drink_summary}}
                                </td>
                                <td class="font-bold text-gray-800">
                                    &#8369;{{order.total_price | number:2}}
                                </td>
                                <td>
                                    <span class="badge badge-sm border-none py-3 px-4 font-semibold uppercase text-[10px]"
                                          ng-class="{
                                            'bg-orange-100 text-orange-600': order.status_id == 1,
                                            'bg-blue-100 text-blue-600': order.status_id == 2,
                                            'bg-green-100 text-green-600': order.status_id == 3,
                                            'bg-red-100 text-red-600': order.status_id == 4
                                          }">
                                        {{order.status}}
                                    </span>
                                </td>
                                <td class="flex justify-center">
                                    <div class="w-44 flex justify-center">

                                        <div ng-if="order.status_id == 1" class="join w-full">
                                            <button class="btn btn-xs btn-info text-white join-item flex-1 font-bold border-none"
                                                    ng-click="updateStatus(order.order_id, 'Approve')">
                                                Approve
                                            </button>
                                            <button class="btn btn-xs btn-outline btn-error join-item flex-1 font-bold"
                                                    ng-click="updateStatus(order.order_id, 'Decline')">
                                                Decline
                                            </button>
                                        </div>

                                        <button ng-if="order.status_id == 2"
                                                class="btn btn-xs btn-success text-white border-none w-full font-bold"
                                                ng-click="updateStatus(order.order_id, 'Complete')">
                                            Complete Order
                                        </button>

                                        <span ng-if="order.status_id >= 3" class="text-xs text-gray-300 italic uppercase font-bold">No actions</span>
                                    </div>
                                </td>
                            </tr>

                            <tr ng-if="allOrders.length == 0">
                                <td colspan="6" class="text-center py-20 text-gray-400">
                                    <div class="flex flex-col items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                        </svg>
                                        <p>No customer orders found yet.</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="drawer-side is-drawer-close:overflow-visible">
        <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="flex min-h-full flex-col items-start bg-coffee-light is-drawer-close:w-14 is-drawer-open:w-64">
            <ul class="menu w-full grow bg-coffee-light">
                <li class="text-white mb-2 pointer-events-none">
                    <div class="flex items-center gap-2">
                        <img src="~/Content/assets/logo-coffee-cat.png" alt="logo" class="h-5 w-auto" />
                        <span class="is-drawer-close:hidden font-bold">Coffee Cat</span>
                    </div>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('AdminDashboard')">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        <span class="is-drawer-close:hidden">Dashboard</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('AdminOrders')">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                        <span class="is-drawer-close:hidden">Orders</span>
                    </button>
                </li>

                <li class="text-white">
                    <button ng-click="redirect('AdminUsers')">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <span class="is-drawer-close:hidden">Users</span>
                    </button>
                </li>
            </ul>

            <ul class="menu w-full mt-auto">
                <li class="text-white">
                    <button ng-click="logout()">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span class="is-drawer-close:hidden">Logout</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>